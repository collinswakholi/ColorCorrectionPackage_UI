    <Style Selector="TextBlock.metricValue">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.toolGroup">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,4" />
    </Style>

    <Style Selector="WrapPanel.stageToolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.catalogTile">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.catalogTile.Selected">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.whiteBadge">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="Border.whiteBadge TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.sourceAction">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.modelAction">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border#Sidebar CheckBox">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel.thumbCell">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Grid.thumbFrame">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.thumbHit">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="76" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="StackPanel.sessionCell">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Width" Value="76" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.thumbClose">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Border#Sidebar.narrow TextBlock.subheading">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Button">
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Border.sidebarAdd">
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Border.sidebarBlock">
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border#Sidebar.narrow ScrollViewer#SidebarScroll">
        <Setter Property="Padding" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Border.sidebarDock">
        <Setter Property="Padding" Value="10,10" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Border.controlSection">
        <Setter Property="Padding" Value="0,8,0,8" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Border.modelCard">
        <Setter Property="Padding" Value="8,8" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Button.sourceAction">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style Selector="Border#Sidebar.narrow StackPanel.thumbCell">
        <Setter Property="Margin" Value="0,0,6,8" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Button.thumbHit">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="Border#Sidebar.narrow StackPanel.sessionCell">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Button.thumbClose">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Border#Sidebar.narrow RadioButton">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border#Sidebar.narrow Border.accelChip">
        <Setter Property="MaxWidth" Value="220" />
    </Style>
    <Style Selector="Border#Sidebar.tight">
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border#Sidebar.tight Border.sidebarAdd">
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border#Sidebar.tight Border.sidebarBlock">
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border#Sidebar.tight ScrollViewer#SidebarScroll">
        <Setter Property="Padding" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border#Sidebar.tight Border.sidebarDock">
        <Setter Property="Padding" Value="8,8" />
    </Style>
    <Style Selector="Border#Sidebar.tight Button.sourceAction">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style Selector="Border#Sidebar.tight Button#RunButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border#Sidebar.tight StackPanel.thumbCell">
        <Setter Property="Margin" Value="0,0,6,8" />
    </Style>
    <Style Selector="Border#Sidebar.tight StackPanel.sessionCell">
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border#Sidebar.tight Button.sessionTool">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border#Sidebar Button">
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border#Sidebar ComboBox">
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border#Sidebar TextBlock.sectionLabel">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LetterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- A quiet inspector: hierarchy comes from type and spacing, not a stack of black cards. -->
    <Style Selector="Border#Sidebar Border.stageRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
    </Style>
    <Style Selector="Border#Sidebar Border.dropZone">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border#Sidebar Border.dropZone.is-dragging">
        <Setter Property="Background" Value="{DynamicResource DropZoneBgBrush}" />
    </Style>
    <Style Selector="Border#Sidebar Rectangle.dropDash">
        <Setter Property="Stroke" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="4,4" />
        <Setter Property="RadiusX" Value="6" />
        <Setter Property="RadiusY" Value="6" />
    </Style>
    <Style Selector="Border.whiteChip.is-dragging">
        <Setter Property="BorderBrush" Value="{DynamicResource DropZoneBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource DropZoneBgBrush}" />
    </Style>
    <Style Selector="Border.controlSection.is-dragging">
        <Setter Property="Background" Value="{DynamicResource DropZoneBgBrush}" />
    </Style>

    <Style Selector="TextBlock.tileName">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.batchFlyout">
        <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="Width" Value="300" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="MaxHeight" Value="520" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #44000000" />
    </Style>

    <Style Selector="Border.folderChip">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="8,2,4,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style Selector="Border.stageRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="Border.modelCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Margin" Value="0,4,2,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Border.whiteChip">
        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="Border.kindBadge">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.videoPlayOverlay">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Button.whiteBadge">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="11"
                        Width="22" Height="22">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Border.sidebarAdd">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,10,14,10" />
    </Style>

    <Style Selector="Window.compact Border#TopBar">
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="Window.short Border.sidebarAdd">
        <Setter Property="Padding" Value="14,8,14,8" />
    </Style>

    <Style Selector="Window.short Border.controlSection">
        <Setter Property="Padding" Value="0,8,0,8" />
    </Style>

    <Style Selector="Window.short Border.dropZone">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Window.short Border.thumbScroller">
        <Setter Property="MaxHeight" Value="120" />
    </Style>
    <Style Selector="Window.short Border.sessionScroller">
        <Setter Property="MaxHeight" Value="102" />
    </Style>

    <Style Selector="Window.short Border.analysisPanel">
        <Setter Property="MinHeight" Value="150" />
    </Style>

    <Style Selector="Window.narrow Border.pickerReadout">
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Window.narrow Border#TopBar">
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Window.narrow ProgressBar.statusProgress">
        <Setter Property="Width" Value="96" />
    </Style>
    <Style Selector="Window.compact TabItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

</Styles>
