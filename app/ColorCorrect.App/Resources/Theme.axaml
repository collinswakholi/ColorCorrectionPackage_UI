    </Style>
    <Style Selector="Border.thumbTile.Selected">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="Border.thumbTile.Active">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="StackPanel.sessionCell:focus-visible Border.thumbTile,
                     StackPanel.thumbCell:focus-visible Border.catalogTile">
