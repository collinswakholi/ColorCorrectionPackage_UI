    <Styles>
    <Styles.Resources>
    <ControlTheme x:Key="SectionHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}" CornerRadius="4">
                    <Grid ColumnDefinitions="12,*">
                        <Path x:Name="ClosedSectionChevron"
                              Data="M 1.5,0.5 L 6.5,5 L 1.5,9.5"
                              IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Width="8" Height="10" Stretch="Uniform"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="50%,50%"/>
                        <Path x:Name="SectionChevron"
                              Data="M 0.5,1.5 L 5,6.5 L 9.5,1.5"
                              IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Width="10" Height="8" Stretch="Uniform" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="SectionExpander" TargetType="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HeaderTemplate">
            <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="sectionLabel"/>
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <ToggleButton x:Name="ExpandCollapseButton"
                                  Theme="{StaticResource SectionHeaderToggle}"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="{TemplateBinding IsExpanded}"
                                      Margin="0,6,0,0"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </ControlTheme>
    <ControlTheme x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="36" />
    </ControlTheme>
    <ControlTheme x:Key="PlotExportButton" TargetType="Button" BasedOn="{StaticResource TinyButton}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
    </ControlTheme>
    <ControlTheme x:Key="TinyIconButton" TargetType="Button" BasedOn="{StaticResource TinyButton}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </ControlTheme>
    <ControlTheme x:Key="PreviewNavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="64" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StageGateBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.86" />
        <Setter Property="ToolTip.Placement" Value="Top" />
        <Style Selector="^:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource GhostLink}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip.Placement" Value="Bottom" />
    </ControlTheme>
    <ControlTheme x:Key="SessionIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </ControlTheme>
    <ControlTheme x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource SessionIconButton}">
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource DangerLightBrush}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="GhostLink" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource CardElevatedBrush}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>
    </Styles.Resources>
    </Styles>

    <Style Selector="Border.analysisPanel">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.plotCard">
