<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.1</Version>
    <InformationalVersion>0.2.1</InformationalVersion>
    <Product>ColorCorrect Studio</Product>
    <AssemblyTitle>ColorCorrect Studio</AssemblyTitle>
    <Description>Professional chart-based color correction for still images.</Description>
    <Company>Collins Wakholi</Company>
    <Authors>Collins Wakholi</Authors>
    <Copyright>Copyright © 2026 Collins Wakholi</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Resources\**" />
    <AvaloniaResource Include="..\..\docs\images\session-workbench.png" Link="Resources\Guide\session-workbench.png" />
    <AvaloniaResource Include="..\..\docs\images\process-controls.png" Link="Resources\Guide\process-controls.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColorCorrect.Engine\ColorCorrect.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ColorCorrect.App.Headless.Tests" />
  </ItemGroup>
</Project>
