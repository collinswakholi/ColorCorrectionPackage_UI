<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ColorCorrect.App.App"
             xmlns:local="using:ColorCorrect.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ColorCorrect.App/Resources/ThemeColors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2F6F62"/>
                <ColorPaletteResources x:Key="Dark" Accent="#2F6F62"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://ColorCorrect.App/Resources/Theme.axaml" />
        <Style Selector="Path.spinner">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0"/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.75" IterationCount="Infinite">
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
