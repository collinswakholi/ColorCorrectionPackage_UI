<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ColorCorrect.App.ViewModels"
        x:Class="ColorCorrect.App.Views.GcSettingsDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="About automatic GC"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Width="360" Height="320" MinWidth="280" MinHeight="260"
        ShowInTaskbar="False"
        CanResize="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Opened="OnOpened">

    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
            CornerRadius="8"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}"
                    CornerRadius="8,8,0,0" Padding="16,12"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Theme="{StaticResource IconButton}"
                            Click="Close_Click" FontSize="16" MinWidth="36" MinHeight="36"
                            AutomationProperties.Name="Close automatic GC details"/>
                    <TextBlock Text="Automatic GC" Classes="heading" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="16,12"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
                <Button x:Name="DoneButton" Content="Done" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="Close_Click"
                        AutomationProperties.Name="Done"/>
            </Border>
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12">
                <TextBlock Text="Monotonic lightness curve" Classes="settingsLabel"/>
                <TextBlock Text="ColorCorrect fits the named neutral patches with a shape-preserving curve anchored at black and white. The curve cannot reverse highlights or overshoot the 0–100 L* range."
                           Classes="caption" TextWrapping="Wrap"/>
                <Border Classes="card" Margin="0,12,0,0" Padding="10">
                    <TextBlock Text="Automatic · shape-preserving · range-safe"
                               Classes="caption" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
