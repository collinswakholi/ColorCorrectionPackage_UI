#!/bin/sh
set -eu
if [ "${1:-}" != --install ]; then
    echo 'Ubuntu 24.04 prerequisites: libc6 libgcc-s1 libstdc++6 libicu74 libssl3t64 libkrb5-3 zlib1g libfontconfig1 libx11-6 libice6 libsm6 libxrandr2 libxi6 libgl1 libvulkan1 libgtk-3-0t64'
    echo 'Use your package manager or rerun with --install to request installation. No GPU driver will be installed.'
    exit 0
fi
. /etc/os-release
[ "$ID" = ubuntu ] && [ "$VERSION_ID" = 24.04 ] || { echo 'Automatic prerequisite setup is limited to Ubuntu 24.04. Use your distribution package manager.' >&2; exit 1; }
echo 'This explicit action requests administrator permission to install the listed system libraries using apt.'
exec sudo apt-get install libc6 libgcc-s1 libstdc++6 libicu74 libssl3t64 libkrb5-3 zlib1g libfontconfig1 libx11-6 libice6 libsm6 libxrandr2 libxi6 libgl1 libvulkan1 libgtk-3-0t64
